# Copy to .env and fill in. .env is git-ignored — never commit real creds.

# --- VPN (client FortiGate via openfortivpn) ---
VPN_GATEWAY=vpn.client.com:443
VPN_USERNAME=
VPN_PASSWORD=
# Leave empty on the FIRST run; openfortivpn will print the cert digest to paste here.
VPN_TRUSTED_CERT=

# Optional SSH tunnels for no_route DBs (leave unset for a routable test DB):
# SSH_JUMP=user@jump-host
# SSH_FORWARDS=16224:192.168.11.160:1521

# --- Oracle (pick ONE routable dealership DB for the smoke test) ---
ORACLE_HOST=192.168.11.251
ORACLE_PORT=1521
# Use exactly ONE of these:
ORACLE_SERVICE=
ORACLE_SID=
ORACLE_USER=
ORACLE_PASSWORD=
