# CarOne profile — VPN + SSH tunnels (password auth) + Oracle via CMAN SOURCE_ROUTE.
# Copy to .env and fill in real creds:  cp .env.carone.example .env
# .env is git-ignored — never commit real creds.

# --- VPN (client FortiGate via openfortivpn) ---
VPN_GATEWAY=
VPN_USERNAME=
VPN_PASSWORD=
# Leave empty on the FIRST run; openfortivpn prints the cert digest to paste here.
VPN_TRUSTED_CERT=

# --- SSH tunnels (CarOne reaches DBs through a Windows jump host) ---
# Forwards are comma-separated  localPort:targetHost:targetPort .
# 16223 = CMAN (SOURCE_ROUTE); 16224/25/26 = direct ports for no_route DBs.
SSH_JUMP=
SSH_FORWARDS=
SSH_PASSWORD=
# SSH_PORT=22            # only if the jump host listens on a non-default port

# --- Which script runs, and its args (config-gated; no image rebuild) ---
SCRIPT_PATH=/scripts/test_oracle_connection.py
SCRIPT_ARGS=--all        # or  --db P_CUALE_KIA_LINDAVISTA  |  --list

# --- Oracle creds (shared across the dealership DBs) ---
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_SERVICE=
# ORACLE_SID=            # use SID instead of SERVICE only if the DB needs it

# --- Tunnel DSN knobs (used by the Oracle test) ---
CMAN_PORT=          # local port of the CMAN SOURCE_ROUTE forward
CONNECT_TIMEOUT=25       # seconds before an unreachable DB gives up
# NO_ROUTE=1             # set with DIRECT_PORT to force a single no_route DB
# DIRECT_PORT=16226
